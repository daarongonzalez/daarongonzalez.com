---
import Nav from "@/components/Nav";
import Footer from "@/components/Footer";
import LoadingScreen from "@/components/LoadingScreen.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  showLoadingScreen?: boolean;
}

const {
  title,
  description = "AI education consultant — design sprints, builds, and workshops that stick.",
  showLoadingScreen = false,
} = Astro.props;

const currentPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#002676" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · D'Aaron Gonzalez</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@700;800&family=Nunito+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          window.__dgFirstVisit = !sessionStorage.getItem("dg-visited");
          sessionStorage.setItem("dg-visited", "1");
        } catch (e) {
          window.__dgFirstVisit = false;
        }
      })();
    </script>
  </head>
  <body>
    {showLoadingScreen && <LoadingScreen />}
    <div class="page-container">
      <Nav currentPath={currentPath} client:load />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
