---
import { loadingQuotes } from "@/data/loadingQuotes";
import koiPrimary from "@/assets/images/koi/koi-primary.webp";
import koiSecondary from "@/assets/images/koi/koi-secondary.webp";
---

<div id="dg-loading-screen" class="dg-loading-screen" hidden>
  <div class="dg-loading-orbit" aria-hidden="true">
    <img
      class="dg-loading-koi dg-loading-koi--lead"
      src={koiPrimary.src}
      width={koiPrimary.width}
      height={koiPrimary.height}
      alt=""
      decoding="sync"
      fetchpriority="high"
    />
    <img
      class="dg-loading-koi dg-loading-koi--trail"
      src={koiSecondary.src}
      width={koiSecondary.width}
      height={koiSecondary.height}
      alt=""
      decoding="sync"
      fetchpriority="high"
    />
  </div>
  <div class="dg-loading-card">
    <p class="dg-loading-quote" id="dg-loading-quote"></p>
    <span class="dg-loading-author" id="dg-loading-author"></span>
  </div>
</div>

<style>
  .dg-loading-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background: var(--color-cream);
    opacity: 1;
    transition:
      opacity 1.1s ease-in-out,
      transform 1.1s ease-in-out;
  }

  .dg-loading-screen--hide {
    opacity: 0;
    transform: translateY(-28px);
  }

  .dg-loading-card {
    position: relative;
    z-index: 3;
    display: flex;
    max-width: 560px;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    transition: opacity 1.1s ease-in-out;
  }

  .dg-loading-card--visible {
    opacity: 1;
  }

  .dg-loading-quote {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(20px, 3vw, 30px);
    line-height: 1.35;
    font-weight: 700;
    color: var(--color-brand-base);
    text-align: center;
  }

  .dg-loading-author {
    align-self: flex-start;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-sun-base);
  }

  /* The two koi share one rotating frame pinned to the centre of the screen,
     each pushed out along opposite ends of the same radius. Carrying them on a
     single transform is what keeps them exactly inverse for the whole sweep —
     animating each one on its own would let rounding drift them apart. */
  .dg-loading-orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 0;
    height: 0;
    pointer-events: none;
    user-select: none;

    --dg-orbit-r: clamp(160px, 26vmin, 280px);

    /* Start of the sweep, a quarter turn back from the finish. CSS rotates
       clockwise, so running up to 0 travels clockwise. */
    transform: rotate(-90deg);
  }

  .dg-loading-koi {
    position: absolute;
    /* Sizes each fish along its own long axis, which the tangent rotation
       below lays horizontal. */
    height: clamp(200px, 52vmin, 520px);
    width: auto;
    /* The orbit frame is a zero-width point, so Tailwind's preflight rule of
       `img { max-width: 100% }` resolves to `max-width: 0` here and collapses
       both koi to nothing. They still animate — there is just no width to
       draw. Opting out is what keeps them visible. */
    max-width: none;
    opacity: 0;
  }

  /* Read right to left: each fish is turned to sit along the path, pushed out
     to the rim, then centred on its orbit point.

     That trailing rotation is what makes them swim rather than tumble. The
     frame's angle and a fish's position on the rim are the same value, so one
     fixed angle per fish holds it tangent to the circle for the whole sweep,
     not only at the landing.

     The two angles differ because the source art does: the navy koi is drawn
     heading up and the gold one heading down-left, so each needs its own
     correction to face along the path. */
  .dg-loading-koi--lead {
    transform: translate(-50%, -50%) translateY(calc(-1 * var(--dg-orbit-r)))
      rotate(81deg);
  }

  .dg-loading-koi--trail {
    transform: translate(-50%, -50%) translateY(var(--dg-orbit-r)) rotate(78deg);
  }

  /* Both fish start together, a beat after the quote has begun to land, so the
     order reads as quote first and then the pair. */
  .dg-loading-screen--in .dg-loading-orbit {
    animation: dg-koi-orbit 2.5s cubic-bezier(0.45, 0, 0.55, 1) 1.25s forwards;
  }

  .dg-loading-screen--in .dg-loading-koi {
    animation: dg-koi-fade 2.5s cubic-bezier(0.45, 0, 0.55, 1) 1.25s forwards;
  }

  /* A quarter turn clockwise, easing in and out of the motion, landing with
     one koi above the quote and one below it. */
  @keyframes dg-koi-orbit {
    from { transform: rotate(-90deg); }
    to { transform: rotate(0deg); }
  }

  @keyframes dg-koi-fade {
    0% { opacity: 0; }
    40% { opacity: 1; }
    72% { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (max-width: 640px) {
    .dg-loading-orbit {
      --dg-orbit-r: clamp(120px, 30vmin, 170px);
    }

    .dg-loading-koi {
      height: clamp(150px, 62vmin, 260px);
    }
  }

  /* No sweep, no fade-out — the koi simply hold their landing positions. */
  @media (prefers-reduced-motion: reduce) {
    .dg-loading-orbit {
      transform: rotate(0deg);
    }

    .dg-loading-screen--in .dg-loading-orbit,
    .dg-loading-screen--in .dg-loading-koi {
      animation: none;
    }

    .dg-loading-koi {
      opacity: 1;
    }
  }
</style>

<script define:vars={{ quotes: loadingQuotes }}>
  (function () {
    var el = document.getElementById("dg-loading-screen");
    if (!el) return;

    if (!window.__dgFirstVisit) {
      el.remove();
      return;
    }

    var pick = quotes[Math.floor(Math.random() * quotes.length)];
    var quoteEl = document.getElementById("dg-loading-quote");
    var authorEl = document.getElementById("dg-loading-author");
    var cardEl = document.querySelector(".dg-loading-card");
    if (quoteEl) quoteEl.textContent = "“" + pick.quote + "”";
    if (authorEl) authorEl.textContent = "— " + pick.author;

    el.hidden = false;
    document.documentElement.classList.add("dg-loading-lock");

    // Commit the hidden-state styles before flipping the classes, so the
    // browser has a starting opacity to transition from rather than
    // painting the final state on the first frame.
    void el.offsetWidth;

    requestAnimationFrame(function () {
      if (cardEl) cardEl.classList.add("dg-loading-card--visible");
      el.classList.add("dg-loading-screen--in");
    });

    var hide = function () {
      el.classList.add("dg-loading-screen--hide");
      document.documentElement.classList.remove("dg-loading-lock");
      // Matches the exit transition above, so the screen is not torn out
      // mid-fade.
      setTimeout(function () {
        el.remove();
      }, 1100);
    };

    // Long enough for the koi sweep to finish (it lands at 3.75s) plus a
    // beat to read the quote against them before the screen leaves.
    var minTime = new Promise(function (resolve) {
      setTimeout(resolve, 4000);
    });
    var pageLoad = new Promise(function (resolve) {
      if (document.readyState === "complete") resolve();
      else window.addEventListener("load", resolve, { once: true });
    });

    Promise.all([minTime, pageLoad]).then(hide);
  })();
</script>
