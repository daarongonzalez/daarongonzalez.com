---
import { loadingQuotes } from "@/data/loadingQuotes";
import koiPrimary from "@/assets/images/koi/koi-primary.webp";
import koiSecondary from "@/assets/images/koi/koi-secondary.webp";
---

<div id="dg-loading-screen" class="dg-loading-screen" hidden>
  <div class="dg-loading-pond" aria-hidden="true">
    <span class="dg-loading-ring dg-loading-ring--1"></span>
    <span class="dg-loading-ring dg-loading-ring--2"></span>
    <span class="dg-loading-ring dg-loading-ring--3"></span>
    <span class="dg-loading-ring dg-loading-ring--4"></span>
  </div>
  <img
    class="dg-loading-koi dg-loading-koi--bl"
    src={koiPrimary.src}
    width={koiPrimary.width}
    height={koiPrimary.height}
    alt=""
    aria-hidden="true"
    decoding="sync"
    fetchpriority="high"
  />
  <img
    class="dg-loading-koi dg-loading-koi--tr"
    src={koiSecondary.src}
    width={koiSecondary.width}
    height={koiSecondary.height}
    alt=""
    aria-hidden="true"
    decoding="sync"
    fetchpriority="high"
  />
  <div class="dg-loading-card">
    <p class="dg-loading-quote" id="dg-loading-quote"></p>
    <span class="dg-loading-author" id="dg-loading-author"></span>
  </div>
</div>

<style>
  .dg-loading-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background: var(--color-cream);
    opacity: 1;
    transition:
      opacity 0.6s ease-in-out,
      transform 0.6s ease-in-out;
  }

  .dg-loading-screen--hide {
    opacity: 0;
    transform: translateY(-28px);
  }

  /* Ripple — a drip spreading from the centre of the pond, under everything else */
  .dg-loading-pond {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .dg-loading-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40vmax;
    height: 40vmax;
    margin: -20vmax 0 0 -20vmax;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--color-brand-base) 55%, transparent);
    opacity: 0;
    transform: scale(0.08);
  }

  /* Linear travel — real ripples spread at a constant rate and decay in
     amplitude, which also keeps the rings evenly spaced as they stack up. */
  .dg-loading-screen--in .dg-loading-ring {
    animation: dg-pond-ring 2.8s linear forwards;
  }

  /* These must match the specificity of the rule above, or its `animation`
     shorthand resets the delay back to 0 and every ring travels in lockstep. */
  .dg-loading-screen--in .dg-loading-ring--1 { animation-delay: 0s; }
  .dg-loading-screen--in .dg-loading-ring--2 { animation-delay: 0.55s; }
  .dg-loading-screen--in .dg-loading-ring--3 { animation-delay: 1.1s; }
  .dg-loading-screen--in .dg-loading-ring--4 { animation-delay: 1.65s; }

  @keyframes dg-pond-ring {
    0% { transform: scale(0.08); opacity: 0; border-width: 2.5px; }
    8% { opacity: 0.65; }
    60% { opacity: 0.5; }
    100% { transform: scale(3.2); opacity: 0; border-width: 0.5px; }
  }

  .dg-loading-card {
    position: relative;
    z-index: 3;
    display: flex;
    max-width: 560px;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
  }

  .dg-loading-card--visible {
    opacity: 1;
  }

  .dg-loading-quote {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(20px, 3vw, 30px);
    line-height: 1.35;
    font-weight: 700;
    color: var(--color-brand-base);
    text-align: center;
  }

  .dg-loading-author {
    align-self: flex-start;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-sun-base);
  }

  /* Koi settle in just after the quote has landed */
  .dg-loading-koi {
    position: absolute;
    z-index: 2;
    height: clamp(150px, 30vh, 368px);
    width: auto;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: opacity 1.1s ease-out 0.85s;
  }

  .dg-loading-koi--tr {
    top: 5vh;
    right: 5vw;
  }

  .dg-loading-koi--bl {
    bottom: 5vh;
    left: 5vw;
  }

  .dg-loading-screen--in .dg-loading-koi {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .dg-loading-koi {
      height: clamp(110px, 19.5vh, 173px);
    }

    .dg-loading-koi--tr {
      top: 3vh;
      right: 3vw;
    }

    .dg-loading-koi--bl {
      bottom: 3vh;
      left: 3vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dg-loading-pond {
      display: none;
    }

    .dg-loading-koi {
      transition: none;
      opacity: 1;
    }
  }
</style>

<script define:vars={{ quotes: loadingQuotes }}>
  (function () {
    var el = document.getElementById("dg-loading-screen");
    if (!el) return;

    if (!window.__dgFirstVisit) {
      el.remove();
      return;
    }

    var pick = quotes[Math.floor(Math.random() * quotes.length)];
    var quoteEl = document.getElementById("dg-loading-quote");
    var authorEl = document.getElementById("dg-loading-author");
    var cardEl = document.querySelector(".dg-loading-card");
    if (quoteEl) quoteEl.textContent = "“" + pick.quote + "”";
    if (authorEl) authorEl.textContent = "— " + pick.author;

    el.hidden = false;
    document.documentElement.classList.add("dg-loading-lock");

    // Commit the hidden-state styles before flipping the classes, so the
    // browser has a starting opacity to transition from rather than
    // painting the final state on the first frame.
    void el.offsetWidth;

    requestAnimationFrame(function () {
      if (cardEl) cardEl.classList.add("dg-loading-card--visible");
      el.classList.add("dg-loading-screen--in");
    });

    var hide = function () {
      el.classList.add("dg-loading-screen--hide");
      document.documentElement.classList.remove("dg-loading-lock");
      setTimeout(function () {
        el.remove();
      }, 600);
    };

    var minTime = new Promise(function (resolve) {
      setTimeout(resolve, 3000);
    });
    var pageLoad = new Promise(function (resolve) {
      if (document.readyState === "complete") resolve();
      else window.addEventListener("load", resolve, { once: true });
    });

    Promise.all([minTime, pageLoad]).then(hide);
  })();
</script>
