---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button";
import ImagePlaceholder from "@/components/ImagePlaceholder";
import ServiceCard from "@/components/ServiceCard";
import StatTile from "@/components/StatTile";
import WorkSection from "@/components/WorkSection";
import TestimonialCard from "@/components/TestimonialCard";
import CTAPanel from "@/components/CTAPanel";
import DotGrid from "@/components/DotGrid";
import { services, aboutStats, hero, testimonials } from "@/data/site";
import { projects } from "@/data/projects";

const featuredProjects = projects.filter((project) => project.featured);
---

<Layout title="AI Education Consultant" background="white">
  <!-- HERO -->
  <section class="mt-5">
    <div class="card card-bordered card-static grid grid-cols-1 overflow-hidden bg-cream lg:grid-cols-[1fr_2fr]">
      <div class="flex flex-col justify-center gap-5 p-14">
        <div class="hd text-[44px] leading-[1.05]">{hero.headline}</div>
        <p class="m-0 text-base leading-relaxed text-ink-dark">{hero.body}</p>
        <div class="mt-2 flex flex-col items-start gap-3">
          <Button href="#contact" variant="primary">Book a Call</Button>
          <Button href="#work" variant="secondary">See my work</Button>
        </div>
      </div>
      <div class="overflow-hidden">
        <ImagePlaceholder label="Headshot photo" className="h-full min-h-[280px]" />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
    {services.map((service) => <ServiceCard {...service} />)}
  </section>

  <!-- ABOUT STRIP -->
  <section id="about" class="mt-6">
    <div class="card grid grid-cols-1 items-center gap-8 bg-brand-base p-12 text-white sm:grid-cols-2">
      <div class="flex flex-col gap-3.5">
        <div class="hd text-sm text-sun-base">About</div>
        <p class="m-0 text-[19px] leading-relaxed">
          I've spent my career at the intersection of design, code, and teaching — helping teams
          turn AI from a buzzword into a working system they actually own.
        </p>
        <a href="/about" class="font-bold text-sun-base">Read my full story →</a>
      </div>
      <div class="flex gap-4">
        {aboutStats.map((stat) => <StatTile {...stat} />)}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="mt-10">
    <WorkSection projects={featuredProjects} client:load />
  </section>

  <!-- TESTIMONIAL + CTA -->
  <section id="contact" class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-[2fr_1fr]">
    <TestimonialCard {...testimonials[0]} />
    <CTAPanel
      title="Ready to talk?"
      description="Let's find the right path for your team's AI implementation."
      buttonLabel="Book a Call"
      buttonHref="#contact"
      layout="compact"
      surface="card"
    />
  </section>

  <!-- TESTIMONIAL 2 -->
  <section class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_2fr]">
    <DotGrid client:visible />
    <TestimonialCard {...testimonials[1]} />
  </section>
</Layout>
