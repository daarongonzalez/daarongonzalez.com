---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button";
import ImagePlaceholder from "@/components/ImagePlaceholder";
import ServiceCard from "@/components/ServiceCard";
import StatTile from "@/components/StatTile";
import WorkCard from "@/components/WorkCard";
import TestimonialCard from "@/components/TestimonialCard";
import CTAPanel from "@/components/CTAPanel";
import { services, aboutStats, testimonial } from "@/data/site";
import { projects } from "@/data/projects";

const featuredProjects = projects.filter((project) => project.featured);
---

<Layout title="AI Education Consultant">
  <!-- HERO -->
  <section class="mt-5 grid grid-cols-1 gap-6 lg:grid-cols-[1.3fr_1fr]">
    <div class="bento flex flex-col justify-center gap-5 bg-sun-lightest p-14">
      <div class="hd text-[52px] leading-[1.05]">AI Education<br />Consultant</div>
      <p class="m-0 max-w-[480px] text-lg leading-relaxed text-ink-dark">
        I help teams move past basic chat and become confident AI orchestrators — through design
        sprints, hands-on builds, and workshops that actually stick.
      </p>
      <div class="mt-2 flex flex-wrap gap-3.5">
        <Button href="#contact" variant="primary">Book a Call</Button>
        <Button href="#work" variant="secondary">See my work</Button>
      </div>
    </div>
    <div class="bento overflow-hidden">
      <ImagePlaceholder label="Headshot photo" className="h-full min-h-[280px]" />
    </div>
  </section>

  <!-- SERVICES -->
  <section class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
    {services.map((service) => <ServiceCard {...service} />)}
  </section>

  <!-- ABOUT STRIP -->
  <section id="about" class="mt-6">
    <div class="bento grid grid-cols-1 items-center gap-8 bg-brand-base p-12 text-white sm:grid-cols-2">
      <div class="flex flex-col gap-3.5">
        <div class="hd text-sm text-sun-base">About</div>
        <p class="m-0 text-[19px] leading-relaxed">
          I've spent my career at the intersection of design, code, and teaching — helping teams
          turn AI from a buzzword into a working system they actually own.
        </p>
        <a href="/about" class="font-bold text-sun-base">Read my full story →</a>
      </div>
      <div class="flex gap-4">
        {aboutStats.map((stat) => <StatTile {...stat} />)}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="mt-10">
    <div class="mb-5 flex items-baseline justify-between">
      <div class="hd text-3xl">Work I've Done</div>
      <a href="#work" class="font-bold">View all →</a>
    </div>
    <div class="flex gap-6 overflow-x-auto pb-2">
      {featuredProjects.map((project) => <WorkCard project={project} />)}
      <div class="bento flex w-[200px] flex-none items-center justify-center bg-ink-lightest">
        <a href="#work" class="text-center font-bold">More projects<br />→</a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL + CTA -->
  <section id="contact" class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-[2fr_1fr]">
    <TestimonialCard {...testimonial} />
    <CTAPanel
      title="Ready to talk?"
      description="Let's find the right path for your team's AI implementation."
      buttonLabel="Book a Call"
      buttonHref="#contact"
      layout="compact"
    />
  </section>
</Layout>
