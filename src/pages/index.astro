---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/Button";
import ServiceCard from "@/components/ServiceCard";
import StatTile from "@/components/StatTile";
import SectionRail from "@/components/SectionRail.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import WorkCard from "@/components/WorkCard";
import HomeBlogCard from "@/components/HomeBlogCard";
import ReviewBand from "@/components/ReviewBand";
import CTAPanel from "@/components/CTAPanel";
import {
  services as defaultServices,
  aboutStats as defaultAboutStats,
  hero as defaultHero,
  reviewSets as defaultReviewSets,
} from "@/data/site";
import { projects } from "@/data/projects";
import { getAllPosts, getSiteSettings } from "@/lib/sanity";
import { pick, mergeReviewSets } from "@/lib/content";
import heroHeadshot from "@/assets/images/hero-headshot.jpg";

const featuredProjects = projects.filter((project) => project.featured);
const recentPosts = (await getAllPosts()).slice(0, 2);
const blogTones = ["sun", "blue"] as const;

const settings = await getSiteSettings();
const hero = {
  eyebrow: pick(settings?.hero?.eyebrow, defaultHero.eyebrow),
  lines: pick(settings?.hero?.lines, defaultHero.lines),
  goldWord: pick(settings?.hero?.goldWord, defaultHero.goldWord),
  body: pick(settings?.hero?.body, defaultHero.body),
};
const services = pick(settings?.services, defaultServices);
const aboutStats = pick(settings?.aboutStats, defaultAboutStats);
const homeAboutStrip = pick(
  settings?.homeAboutStrip,
  "I've spent my career at the intersection of design, code, and teaching — helping teams turn AI from a buzzword into a working system they actually own.",
);
const homeSections = {
  workHeading: pick(settings?.homeSections?.workHeading, "Work I've done"),
  workBlurb: pick(settings?.homeSections?.workBlurb, "A few of the builds I've taken clients through, start to ship."),
  blogHeading: pick(settings?.homeSections?.blogHeading, "Writing & notes"),
  blogBlurb: pick(
    settings?.homeSections?.blogBlurb,
    "Thoughts on AI strategy, education, and building without shortcuts.",
  ),
};
const reviewSets = mergeReviewSets(settings?.reviewSets, defaultReviewSets);
const homeCta = {
  title: pick(settings?.homeCta?.title, "Ready to talk?"),
  description: pick(
    settings?.homeCta?.description,
    "Let's find the right path for your team's AI implementation.",
  ),
  buttonLabel: pick(settings?.homeCta?.buttonLabel, "Book a Call"),
};
---

<Layout title="AI Education Consultant" showLoadingScreen>
  <!-- HERO -->
  <section class="mt-5">
    <div class="bento bento-hero grid min-h-[520px] grid-cols-1 overflow-hidden lg:grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)]">
      <div class="relative flex flex-col justify-center gap-6 overflow-hidden bg-brand-base p-8 text-cream sm:px-14 sm:py-16">
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
          <div class="absolute -right-[90px] -top-[110px] h-[340px] w-[340px] rounded-full bg-sun-base opacity-[.09]"></div>
          <div class="absolute -bottom-[160px] -left-[140px] h-[420px] w-[420px] rounded-full bg-cream opacity-[.05]"></div>
          <div class="absolute -bottom-[70px] right-[60px] h-[220px] w-[220px] rounded-full border-2 border-sun-base opacity-[.16]"></div>
          <div class="absolute -top-[60px] left-[180px] h-[160px] w-[160px] rounded-full border-2 border-cream opacity-10"></div>
        </div>
        <div class="relative flex flex-col gap-6">
          <div class="text-[12.5px] font-bold uppercase tracking-[.2em] text-sun-base">{hero.eyebrow}</div>
          <div class="hd text-[clamp(44px,5.6vw,82px)] leading-[.88] tracking-[-.025em]">
            {hero.lines.map((line) => (
              <>
                {line}
                <br />
              </>
            ))}
            <span class="text-sun-base">{hero.goldWord}</span>
          </div>
          <p class="m-0 max-w-[420px] text-[17px] leading-[1.55] text-brand-lighter">{hero.body}</p>
          <div class="mt-1 flex flex-wrap gap-3">
            <Button href="#contact" variant="accent">Book a Call</Button>
            <Button href="#work" variant="outline-light">See my work</Button>
          </div>
        </div>
      </div>
      <div class="overflow-hidden bg-cream-deep">
        <img
          src={heroHeadshot.src}
          width={heroHeadshot.width}
          height={heroHeadshot.height}
          alt="D'Aaron Gonzalez"
          class="h-full min-h-[280px] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-3">
    {services.map((service, i) => <ServiceCard number={`0${i + 1}`} {...service} />)}
  </section>

  <!-- ABOUT STRIP -->
  <section id="about" class="mt-10 flex flex-col gap-[18px]">
    <SectionRail label="01 / ABOUT" linkLabel="Full story →" linkHref="/about" />
    <div class="bento grid grid-cols-1 items-center gap-8 bg-brand-base p-12 text-white sm:grid-cols-2">
      <div class="flex flex-col gap-3.5">
        <p class="m-0 text-[19px] leading-relaxed">
          {homeAboutStrip}
        </p>
        <a href="/about" class="font-bold text-sun-base">Read my full story →</a>
      </div>
      <div class="flex gap-4">
        {aboutStats.map((stat) => <StatTile {...stat} />)}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="mt-14 flex flex-col gap-8">
    <div class="flex flex-col gap-[18px]">
      <SectionRail label="02 / WORK" linkLabel="View all →" linkHref="#work" />
      <SectionHeading heading={homeSections.workHeading} blurb={homeSections.workBlurb}>
        <div class="flex gap-3.5">
          <button
            id="work-scroll-left"
            type="button"
            aria-label="Scroll work row left"
            class="cursor-pointer text-[22px] font-bold leading-none text-sun-base transition-[color,transform] duration-200 hover:-translate-x-0.5 hover:text-brand-base"
          >
            ←
          </button>
          <button
            id="work-scroll-right"
            type="button"
            aria-label="Scroll work row right"
            class="cursor-pointer text-[22px] font-bold leading-none text-sun-base transition-[color,transform] duration-200 hover:translate-x-0.5 hover:text-brand-base"
          >
            →
          </button>
        </div>
      </SectionHeading>
    </div>
    <div id="work-row" class="flex flex-nowrap gap-6 overflow-x-auto pb-2" style="scroll-behavior: smooth">
      {featuredProjects.map((project) => <WorkCard project={project} />)}
    </div>
  </section>

  <!-- BLOG -->
  {recentPosts.length > 0 && (
    <>
      <div class="cut-rule mt-14" aria-hidden="true"></div>
      <section id="blog" class="mt-8 flex flex-col gap-8">
        <div class="flex flex-col gap-[18px]">
          <SectionRail label="03 / BLOG" linkLabel="All posts →" linkHref="/blog" />
          <SectionHeading heading={homeSections.blogHeading} blurb={homeSections.blogBlurb} />
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {recentPosts.map((post, i) => <HomeBlogCard post={post} tone={blogTones[i % 2]} />)}
        </div>
      </section>
    </>
  )}

  <!-- PRAISE -->
  <ReviewBand sets={reviewSets} client:load />

  <!-- CTA -->
  <section id="contact" class="mt-10">
    <CTAPanel
      title={homeCta.title}
      description={homeCta.description}
      buttonLabel={homeCta.buttonLabel}
      buttonHref="#contact"
      tone="cream"
      padding="p-12"
      headingClassName="text-[40px] leading-none"
      descriptionClassName="text-base"
    />
  </section>
</Layout>

<script>
  const row = document.getElementById("work-row");
  document.getElementById("work-scroll-left")?.addEventListener("click", () => {
    row?.scrollBy({ left: -364, behavior: "smooth" });
  });
  document.getElementById("work-scroll-right")?.addEventListener("click", () => {
    row?.scrollBy({ left: 364, behavior: "smooth" });
  });
</script>
