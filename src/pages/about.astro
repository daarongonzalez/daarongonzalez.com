---
import Layout from "@/layouts/Layout.astro";
import SectionRail from "@/components/SectionRail.astro";
import TimelineCard from "@/components/TimelineCard";
import ApproachCard from "@/components/ApproachCard";
import CTAPanel from "@/components/CTAPanel";
import { timeline as defaultTimeline, approach as defaultApproach } from "@/data/site";
import { getSiteSettings } from "@/lib/sanity";
import { pick } from "@/lib/content";
import aboutPhoto from "@/assets/images/about-photo.jpg";

const settings = await getSiteSettings();
const timeline = pick(settings?.timeline, defaultTimeline);
const approach = pick(settings?.approach, defaultApproach);
const aboutIntro = {
  heading: pick(settings?.aboutIntro?.heading, "Educator, strategist, developer — in that order."),
  body: pick(
    settings?.aboutIntro?.body,
    "I've spent my career at the intersection of design, code, and teaching. Before AI made \"orchestration\" a buzzword, I was already helping teams build systems they could actually understand and own — not just tools they rented. Today I run design sprints, ship full builds, and train teams to carry the work forward without me.",
  ),
};
const aboutCta = {
  title: pick(settings?.aboutCta?.title, "Let's build something together."),
  description: pick(settings?.aboutCta?.description, "Design sprints, full builds, or team training — let's talk."),
  buttonLabel: pick(settings?.aboutCta?.buttonLabel, "Book a Call"),
};
---

<Layout title="About" description="Educator, strategist, developer — in that order.">
  <!-- INTRO -->
  <section class="mt-5 flex flex-col gap-6">
    <SectionRail label="01 / ABOUT" linkLabel="← Home" linkHref="/" />
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_1.2fr]">
      <div class="bento overflow-hidden">
        <img
          src={aboutPhoto.src}
          width={aboutPhoto.width}
          height={aboutPhoto.height}
          alt="D'Aaron Gonzalez, working"
          class="h-full min-h-[280px] w-full object-cover"
        />
      </div>
      <div class="bento flex flex-col justify-center gap-4 bg-sun-lightest p-12">
        <div class="hd text-[52px] leading-[.92] tracking-[-.02em]">
          {aboutIntro.heading}
        </div>
        <p class="m-0 text-base leading-relaxed text-ink-dark">
          {aboutIntro.body}
        </p>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="mt-8">
    <SectionRail label="02 / PATH" variant="sub" />
    <div class="hd mb-5 text-[40px] leading-[.92]">How I got here</div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {timeline.map((step) => <TimelineCard {...step} />)}
    </div>
  </section>

  <!-- APPROACH -->
  <section class="mt-8">
    <SectionRail label="03 / METHOD" variant="sub" />
    <div class="hd mb-5 text-[40px] leading-[.92]">How I work</div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {approach.map((item) => <ApproachCard {...item} />)}
    </div>
  </section>

  <!-- CTA -->
  <section class="mt-10">
    <CTAPanel
      title={aboutCta.title}
      description={aboutCta.description}
      buttonLabel={aboutCta.buttonLabel}
      buttonHref="/#contact"
    />
  </section>
</Layout>
