---
import Layout from "@/layouts/Layout.astro";
import ImagePlaceholder from "@/components/ImagePlaceholder";
import Button from "@/components/Button";
import EventRow from "@/components/EventRow";
import CTAPanel from "@/components/CTAPanel";
import { getAllEvents, urlFor } from "@/lib/sanity";
import { formatDate } from "@/lib/format";

const events = await getAllEvents();
const upcoming = events
  .filter((event) => event.status !== "past")
  .sort((a, b) => new Date(a.startsAt).getTime() - new Date(b.startsAt).getTime());
const [nextEvent, ...restUpcoming] = upcoming;
const pastEvents = events
  .filter((event) => event.status === "past")
  .sort((a, b) => new Date(b.startsAt).getTime() - new Date(a.startsAt).getTime());
---

<Layout title="Events" description="Live sessions on AI strategy, tooling, and orchestration.">
  <section class="mt-5">
    <div class="hd text-sm text-brand-base">Events</div>
    <div class="hd mt-1.5 text-[40px]">Workshops &amp; Events</div>
    <p class="m-0 mt-2 max-w-[560px] text-base text-ink-dark">
      Live sessions on AI strategy, tooling, and orchestration — for teams and individuals.
    </p>
  </section>

  {nextEvent && (
    <section class="mt-7">
      <div class="bento grid grid-cols-1 overflow-hidden bg-sun-lightest lg:grid-cols-[1fr_1.2fr]">
        {nextEvent.coverImage ? (
          <img
            src={urlFor(nextEvent.coverImage).width(700).height(480).url()}
            alt={nextEvent.title}
            class="h-[240px] w-full object-cover lg:h-full"
          />
        ) : (
          <ImagePlaceholder label={nextEvent.title} className="h-[240px] lg:h-full" />
        )}
        <div class="flex flex-col justify-center gap-3.5 p-11">
          <span class="tag-pill w-fit bg-sun-base text-ink-darker">Next Up</span>
          <div class="hd text-[28px]">{nextEvent.title}</div>
          <p class="m-0 text-[15px] leading-relaxed text-ink-dark">{nextEvent.description}</p>
          <div class="text-sm font-bold text-ink-dark">
            {formatDate(nextEvent.startsAt)}{nextEvent.location ? ` · ${nextEvent.location}` : ""}
          </div>
          <Button href={`/events/${nextEvent.slug}`} variant="primary" className="w-fit">Register</Button>
        </div>
      </div>
    </section>
  )}

  <section class="mt-8">
    <div class="hd mb-4 text-[22px]">Upcoming</div>
    <div class="flex flex-col gap-3.5">
      {restUpcoming.map((event) => (
        <EventRow slug={event.slug} title={event.title} date={formatDate(event.startsAt)} variant="upcoming" />
      ))}
      {restUpcoming.length === 0 && (
        <p class="text-ink-base">No other upcoming events right now.</p>
      )}
    </div>
  </section>

  <section class="mt-8">
    <div class="hd mb-4 text-[22px]">Past Events</div>
    <div class="flex flex-col gap-3.5">
      {pastEvents.map((event) => (
        <EventRow slug={event.slug} title={event.title} date={formatDate(event.startsAt)} variant="past" />
      ))}
      {pastEvents.length === 0 && <p class="text-ink-base">No past events yet.</p>}
    </div>
  </section>

  <section class="mt-10">
    <CTAPanel
      title="Want a private session for your team?"
      description="We'll tailor a workshop to where your team actually is."
      buttonLabel="Book a Call"
      buttonHref="/#contact"
    />
  </section>
</Layout>
