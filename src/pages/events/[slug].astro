---
import Layout from "@/layouts/Layout.astro";
import ImagePlaceholder from "@/components/ImagePlaceholder";
import Button from "@/components/Button";
import { getEventBySlug, urlFor } from "@/lib/sanity";
import { formatDate } from "@/lib/format";

const { slug } = Astro.params;
const event = slug ? await getEventBySlug(slug) : null;

if (!event) {
  return Astro.redirect("/events");
}

const isPast = event.status === "past";
---

<Layout title={event.title} description={event.description ?? event.title}>
  <a href="/events" class="mt-2 inline-block text-sm font-bold">← Back to events</a>

  <article class="mt-4">
    <div class="bento overflow-hidden">
      {event.coverImage ? (
        <img
          src={urlFor(event.coverImage).width(1200).height(640).url()}
          alt={event.title}
          class="h-[320px] w-full object-cover"
        />
      ) : (
        <ImagePlaceholder label={event.title} className="h-[320px]" />
      )}
    </div>
    <div class="mt-6 flex flex-col gap-3">
      <h1 class="hd text-[38px] leading-tight">{event.title}</h1>
      <div class="text-[13px] text-ink-base">
        {formatDate(event.startsAt)}{event.location ? ` · ${event.location}` : ""}
      </div>
    </div>
    <div class="bento mt-6 bg-cream p-10">
      <p class="m-0 text-base leading-relaxed text-ink-dark">{event.description}</p>
    </div>
    {!isPast && (
      <div class="mt-6">
        <Button href={event.lumaUrl} variant="primary" target="_blank" rel="noopener noreferrer">
          Register on Luma
        </Button>
      </div>
    )}
  </article>
</Layout>
