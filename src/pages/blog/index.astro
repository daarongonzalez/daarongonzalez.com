---
import Layout from "@/layouts/Layout.astro";
import SectionRail from "@/components/SectionRail.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import FeaturedBlogCard from "@/components/FeaturedBlogCard";
import BlogFilter from "@/components/BlogFilter";
import { getAllPosts } from "@/lib/sanity";

const posts = await getAllPosts();
const featuredPost = posts.find((post) => post.featured) ?? posts[0];
const gridPosts = posts.filter((post) => post._id !== featuredPost?._id);
---

<Layout title="Blog" description="Thoughts on AI strategy, education, and building without shortcuts.">
  <section class="mt-5 flex flex-col gap-[18px]">
    <SectionRail label="01 / BLOG" linkLabel="← Home" linkHref="/" />
    <SectionHeading
      heading="Notes & field guides"
      blurb="Thoughts on AI strategy, education, and building without shortcuts."
    />
  </section>

  {featuredPost && (
    <section class="mt-7">
      <FeaturedBlogCard post={featuredPost} />
    </section>
  )}

  <section class="mt-6">
    <BlogFilter posts={gridPosts} client:load />
  </section>

  {posts.length === 0 && (
    <p class="mt-6 text-center text-ink-base">No posts published yet — check back soon.</p>
  )}
</Layout>
