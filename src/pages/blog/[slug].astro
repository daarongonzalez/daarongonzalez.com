---
import Layout from "@/layouts/Layout.astro";
import ImagePlaceholder from "@/components/ImagePlaceholder";
import PortableText from "@/components/PortableText";
import { getPostBySlug, urlFor } from "@/lib/sanity";
import { formatDate, estimateReadTime } from "@/lib/format";

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

if (!post) {
  return Astro.redirect("/blog");
}
---

<Layout title={post.title} description={post.seoDescription ?? post.excerpt ?? post.title}>
  <a href="/blog" class="mt-2 inline-block text-sm font-bold">← Back to blog</a>

  <article class="mt-4">
    <div class="bento overflow-hidden">
      {post.coverImage ? (
        <img
          src={urlFor(post.coverImage).width(1200).height(640).url()}
          alt={post.title}
          class="h-[320px] w-full object-cover"
        />
      ) : (
        <ImagePlaceholder label={post.title} className="h-[320px]" />
      )}
    </div>
    <div class="mt-6 flex flex-col gap-3">
      {post.category && <span class="tag-pill w-fit bg-sun-lighter text-sun-darker">{post.category}</span>}
      <h1 class="hd text-[38px] leading-tight">{post.title}</h1>
      <div class="text-[13px] text-ink-base">
        {formatDate(post.publishedAt)} · {estimateReadTime(post.body as never)}
      </div>
    </div>
    <div class="bento mt-6 bg-white p-10">
      <PortableText value={post.body} />
    </div>
  </article>
</Layout>
