---
import Layout from "@/layouts/Layout.astro";
import ImagePlaceholder from "@/components/ImagePlaceholder";
import { posts } from "@/data/posts";

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---

<Layout title={post.title} description={post.title}>
  <a href="/blog" class="mt-2 inline-block text-sm font-bold">← Back to blog</a>

  <article class="mt-4">
    <div class="bento overflow-hidden">
      <ImagePlaceholder label={post.imageLabel} className="h-[320px]" />
    </div>
    <div class="mt-6 flex flex-col gap-3">
      <span class="tag-pill w-fit bg-sun-lighter text-sun-darker">{post.category}</span>
      <h1 class="hd text-[38px] leading-tight">{post.title}</h1>
      <div class="text-[13px] text-ink-base">{post.date} · {post.readTime}</div>
    </div>
    <div class="bento mt-6 bg-white p-10">
      <p class="m-0 text-base leading-relaxed text-ink-dark">
        Full post content coming soon.
      </p>
    </div>
  </article>
</Layout>
