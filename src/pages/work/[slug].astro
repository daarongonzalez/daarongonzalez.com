---
import Layout from "@/layouts/Layout.astro";
import ImagePlaceholder from "@/components/ImagePlaceholder";
import TagPill from "@/components/TagPill";
import SectionRail from "@/components/SectionRail.astro";
import PortableText, { BodyImage, type BodyImageValue } from "@/components/PortableText";
import { ProblemSolution, Gallery, PhotoStrip, ResultsStrip, PrevNextNav } from "@/components/CaseStudySections";
import { loadProjects } from "@/data/work";

// Rendered on each request so projects added or edited in Sanity show up right away.
const allProjects = await loadProjects();
const index = allProjects.findIndex((entry) => entry.slug === Astro.params.slug);
if (index === -1) {
  return Astro.redirect("/work");
}
const project = allProjects[index];
const previous = allProjects[index - 1];
const next = allProjects[index + 1];
const cs = project.caseStudy;

// Sections after Problem / Solution are numbered in order, starting at 02, skipping any that are empty.
const hasBody = Boolean(cs?.body?.length);

// The story is split at its image blocks: text runs become cards, and each image sits
// between them at full width, so a long write-up reads in sections.
type StoryPart = { kind: "text"; blocks: unknown[] } | { kind: "image"; image: BodyImageValue };
const storyParts: StoryPart[] = [];
for (const item of (cs?.body ?? []) as { _type?: string }[]) {
  if (item._type === "image") {
    storyParts.push({ kind: "image", image: item as BodyImageValue });
  } else {
    const last = storyParts[storyParts.length - 1];
    if (last?.kind === "text") last.blocks.push(item);
    else storyParts.push({ kind: "text", blocks: [item] });
  }
}
const hasPhotos = Boolean(cs?.photos?.length);
let sectionCount = 1;
const nextNumber = () => String(++sectionCount).padStart(2, "0");
const bodyNumber = hasBody ? nextNumber() : "";
const photosNumber = hasPhotos ? nextNumber() : "";
const processNumber = nextNumber();
---

<Layout title={project.title} description={cs?.description ?? project.shortDescription}>
  <a href="/work" class="mt-2 inline-block text-sm font-bold">← Back to work</a>

  <!-- HERO -->
  <section class="mt-4">
    <div class="bento flex flex-col gap-4 bg-cream p-7 sm:p-11">
      {project.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {project.tags.map((tag) => <TagPill label={tag.label} tone={tag.tone} />)}
        </div>
      )}
      {cs?.eyebrow && <div class="text-xs font-bold tracking-[.14em] text-sun-dark uppercase">{cs.eyebrow}</div>}
      <h1 class="hd m-0 text-[40px] leading-[.9] tracking-[-.02em] break-words sm:text-[64px]">{project.title}</h1>
      {cs?.subtitle && <p class="m-0 text-xl font-bold leading-snug text-brand-base sm:text-2xl">{cs.subtitle}</p>}
      <p class="m-0 max-w-[640px] text-[17px] leading-relaxed text-ink-dark">
        {cs?.description ?? project.shortDescription}
      </p>
    </div>
    <div class="bento mt-6 overflow-hidden">
      {cs?.heroImage ? (
        <img
          src={cs.heroImage}
          alt={cs.heroImageLabel}
          class="aspect-video w-full object-cover md:aspect-auto md:h-[480px]"
        />
      ) : (
        <ImagePlaceholder label={cs?.heroImageLabel ?? project.imageLabel} className="h-[280px] md:h-[480px]" />
      )}
    </div>
  </section>

  {cs && (
    <>
      <ProblemSolution
        problemLabel={cs.problemLabel}
        problem={cs.problem}
        solutionLabel={cs.solutionLabel}
        solution={cs.solution}
      />
      {hasBody && (
        <section class="mt-6">
          <SectionRail label={`${bodyNumber} / STORY`} variant="sub" />
          <div class="flex flex-col gap-6">
            {storyParts.map((part) =>
              part.kind === "image" ? (
                <BodyImage value={part.image} />
              ) : (
                <div class="bento bg-white p-7 sm:p-11 [&>div>*:first-child]:mt-0 [&>div>*:last-child]:mb-0">
                  <div class="max-w-[720px]">
                    <PortableText value={part.blocks} />
                  </div>
                </div>
              ),
            )}
          </div>
        </section>
      )}
      {hasPhotos && (
        <section class="mt-6">
          <SectionRail label={`${photosNumber} / IN THE ROOM`} variant="sub" />
          <div class="hd mb-5 text-[32px] leading-[.92] sm:text-[40px]">Photos</div>
          <PhotoStrip photos={cs.photos!} />
        </section>
      )}
      {cs.gallery.length > 0 && (
        <section class="mt-6">
          <SectionRail label={`${processNumber} / PROCESS`} variant="sub" />
          <div class="hd mb-5 text-[32px] leading-[.92] sm:text-[40px]">{cs.galleryHeading ?? "Process & screens"}</div>
          <Gallery images={cs.gallery} />
        </section>
      )}
      {cs.results.length > 0 && <ResultsStrip results={cs.results} note={cs.resultsNote} />}
    </>
  )}

  <PrevNextNav previous={previous} next={next} />
</Layout>
