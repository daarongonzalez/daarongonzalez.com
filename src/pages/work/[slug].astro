---
import Layout from "@/layouts/Layout.astro";
import ImagePlaceholder from "@/components/ImagePlaceholder";
import TagPill from "@/components/TagPill";
import SectionRail from "@/components/SectionRail.astro";
import { ProblemSolution, Gallery, ResultsStrip, PrevNextNav } from "@/components/CaseStudySections";
import { projects, getAdjacentProjects, type Project } from "@/data/projects";

export const prerender = true;

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { previous, next } = getAdjacentProjects(project.slug);
const cs = project.caseStudy;
---

<Layout title={project.title} description={cs?.description ?? project.shortDescription}>
  <a href="/#work" class="mt-2 inline-block text-sm font-bold">← Back to work</a>

  <!-- HERO -->
  <section class="mt-4">
    <div class="bento flex flex-col gap-4 bg-cream p-11">
      {project.tags.length > 0 && (
        <div class="flex gap-2">
          {project.tags.map((tag) => <TagPill label={tag.label} tone={tag.tone} />)}
        </div>
      )}
      <div class="hd text-[64px] leading-[.9] tracking-[-.02em]">{project.title}</div>
      <p class="m-0 max-w-[640px] text-[17px] leading-relaxed text-ink-dark">
        {cs?.description ?? project.shortDescription}
      </p>
    </div>
    <div class="bento mt-6 overflow-hidden">
      <ImagePlaceholder label={cs?.heroImageLabel ?? project.imageLabel} className="h-[480px]" />
    </div>
  </section>

  {cs && (
    <>
      <ProblemSolution
        problemLabel={cs.problemLabel}
        problem={cs.problem}
        solutionLabel={cs.solutionLabel}
        solution={cs.solution}
      />
      <section class="mt-6">
        <SectionRail label="02 / PROCESS" variant="sub" />
        <div class="hd mb-5 text-[40px] leading-[.92]">Process &amp; screens</div>
        <Gallery images={cs.gallery} />
      </section>
      <ResultsStrip results={cs.results} />
    </>
  )}

  <PrevNextNav previous={previous} next={next} />
</Layout>
